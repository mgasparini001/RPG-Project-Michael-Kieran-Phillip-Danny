{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build RPG Project",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-Command",
                "g++ -o RPGGame (Get-ChildItem *.cpp | ForEach-Object { $_.Name }) -std=c++17"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        }
    ]
}
